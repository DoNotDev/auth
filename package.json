{
  "name": "@donotdev/auth",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Everything you'd need to manage authentication and authorization",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "guidelines",
    "package.json",
    "README.md",
    "LICENSE.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/donotdev/auth.git"
  },
  "keywords": [
    "donotdev",
    "dndev",
    "auth",
    "authentication",
    "authorization",
    "firebase",
    "react",
    "typescript"
  ],
  "scripts": {
    "dev": "tsc --noEmit --watch --listFiles false --listEmittedFiles false",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint": "eslint src/",
    "type-check": "bunx tsc --noEmit"
  },
  "peerDependencies": {
    "@donotdev/components": "^0.2.1",
    "@donotdev/core": "^0.2.1",
    "@donotdev/firebase": "^0.2.0",
    "@donotdev/supabase": "^0.2.0",
    "lucide-react": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "*"
  },
  "peerDependenciesMeta": {
    "@donotdev/firebase": {
      "optional": true
    },
    "@donotdev/supabase": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@donotdev/components": "workspace:*",
    "@donotdev/core": "workspace:*",
    "@donotdev/firebase": "workspace:*",
    "@donotdev/supabase": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
